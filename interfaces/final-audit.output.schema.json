{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/project-final-audit/final-audit.output.schema.json",
  "title": "FinalAuditOutput",
  "type": "object",
  "properties": {
    "progress_board": { "type": "string" },
    "security_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "api_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": { "type": "string" },
          "path": { "type": "string" },
          "auth": { "type": "string" },
          "source": { "type": "string" },
          "documented": { "type": "string" },
          "test_coverage": { "type": "string" }
        },
        "required": ["method", "path"],
        "additionalProperties": true
      }
    },
    "api_test_matrix": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "api_test_results": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "documentation_nonconformance": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "blocked_items": { "type": "array", "items": { "$ref": "#/$defs/blocker" } },
    "release_readiness": {
      "type": "string",
      "enum": ["Ready", "Ready with risks", "Not ready", "Unknown"]
    },
    "final_recommendation": { "type": "string" }
  },
  "required": ["progress_board", "release_readiness", "final_recommendation"],
  "$defs": {
    "finding": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "severity": { "type": "string", "enum": ["Critical", "High", "Medium", "Low", "Info"] },
        "status": { "type": "string" },
        "title": { "type": "string" },
        "location": { "type": "string" },
        "evidence": { "type": "string" },
        "impact": { "type": "string" },
        "recommendation": { "type": "string" },
        "retest": { "type": "string" }
      },
      "required": ["id", "status", "title"],
      "additionalProperties": true
    },
    "blocker": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "status": { "type": "string", "const": "BLOCKED" },
        "missing": { "type": "string" },
        "needed": { "type": "string" }
      },
      "required": ["id", "status", "missing", "needed"],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
